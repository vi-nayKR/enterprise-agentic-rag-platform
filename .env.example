# Existing application settings (no live-provider credentials by default).
OPENAI_API_KEY=sk-placeholder
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# One local Qwen model handles answering, rewriting, and judging during evaluation.
EVAL_LLM_BASE_URL=http://127.0.0.1:8091/v1
EVAL_LLM_MODEL=evidencerag-local
EVAL_LLM_LOCAL=true
EVAL_LLM_API_KEY=
EVAL_BUDGET_USD=2.99
EVAL_INPUT_USD_PER_MILLION=0
EVAL_OUTPUT_USD_PER_MILLION=0
